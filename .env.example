# Discord Bot Credentials (REQUIRED)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here           # Optional: Fast slash command testing in single guild
DEFAULT_PREFIX=?

# Spotify Credentials (OPTIONAL — for Spotify search & track resolution)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Lavalink Node Credentials (REQUIRED)
LAVALINK_NAME=MainNode
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
