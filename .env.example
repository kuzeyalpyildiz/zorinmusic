# ==========================================
# Zorin Music — Environment Configuration
# ==========================================

# Discord Bot Credentials (REQUIRED)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here           # Optional: Fast slash command testing in single guild
DEFAULT_PREFIX=!

# Spotify Credentials (OPTIONAL — for Spotify search & track resolution)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Lavalink Nodes (REQUIRED — at least one) ──
#
# Format:  Name:Host:Port:Password:Secure
#   - Separate multiple nodes with |  (pipe)
#   - "Secure" is optional, defaults to false
#
# Single node example:
#   LAVALINK_NODES=MainNode:localhost:2333:youshallnotpass:false
#
# Multi-node failover pool example:
#   LAVALINK_NODES=Primary:lava1.example.com:2333:pass1:false|Backup:lava2.example.com:2333:pass2:false|Emergency:lava3.example.com:443:pass3:true
#
LAVALINK_NODES=MainNode:localhost:2333:youshallnotpass:false

# ── Legacy single-node format (still works if LAVALINK_NODES is not set) ──
# LAVALINK_NAME=MainNode
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
